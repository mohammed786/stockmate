generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth Models ────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases      Purchase[]
  sales          Sale[]
  stockMovements StockMovement[]
  auditLogs      AuditLog[]

  @@map("users")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

// ─── Core Domain Models ─────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. SGG, GG, ASAHI
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   Product[]
  purchases  Purchase[]
  sales      Sale[]

  @@map("companies")
}

model Product {
  id          String   @id @default(cuid())
  code        String   @unique // generated from company+name
  name        String
  companyId   String
  height      Decimal  @db.Decimal(10, 2) // cm
  width       Decimal  @db.Decimal(10, 2) // cm
  thickness   Decimal  @db.Decimal(10, 2) // mm
  mtrRate     Decimal  @db.Decimal(12, 2) // rate per running meter
  sqmtRate    Decimal  @db.Decimal(12, 2) // rate per sqmt
  unit        String   @default("SHEET") // SHEET, CASE, etc.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  stockOpenings  StockOpening[]
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([companyId])
  @@index([name])
  @@map("products")
}

model StockOpening {
  id        String  @id @default(cuid())
  productId String
  month     Int     // 1-12
  year      Int     // e.g. 2026
  sheets    Decimal @default(0) @db.Decimal(12, 2)
  cases     Decimal @default(0) @db.Decimal(12, 2)

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, month, year])
  @@index([month, year])
  @@map("stock_openings")
}

// ─── Transaction Models ─────────────────────────────────────

model Purchase {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  companyId   String?
  invoiceNo   String?
  notes       String?
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company?  @relation(fields: [companyId], references: [id])
  user    User?     @relation(fields: [userId], references: [id])
  items   PurchaseItem[]

  @@index([date])
  @@index([companyId])
  @@map("purchases")
}

model PurchaseItem {
  id          String  @id @default(cuid())
  purchaseId  String
  productId   String
  sheets      Decimal @default(0) @db.Decimal(12, 2)
  cases       Decimal @default(0) @db.Decimal(12, 2)
  rate        Decimal? @db.Decimal(12, 2) // optional rate override
  notes       String?

  purchase  Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model Sale {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  companyId   String?
  customerName String?
  invoiceNo   String?
  notes       String?
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company?  @relation(fields: [companyId], references: [id])
  user    User?     @relation(fields: [userId], references: [id])
  items   SaleItem[]

  @@index([date])
  @@index([companyId])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  sheets    Decimal @default(0) @db.Decimal(12, 2)
  cases     Decimal @default(0) @db.Decimal(12, 2)
  rate      Decimal? @db.Decimal(12, 2)
  notes     String?

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// ─── Stock Ledger ───────────────────────────────────────────

enum MovementType {
  OPENING
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  DAMAGE
  TRANSFER
}

model StockMovement {
  id          String       @id @default(cuid())
  productId   String
  date        DateTime     @db.Date
  type        MovementType
  sheets      Decimal      @db.Decimal(12, 2) // positive = in, negative = out
  cases       Decimal      @db.Decimal(12, 2)
  referenceId String?      // purchase.id or sale.id
  referenceType String?    // "PURCHASE" or "SALE"
  notes       String?
  userId      String?
  createdAt   DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([productId, date])
  @@index([date])
  @@index([referenceId])
  @@map("stock_movements")
}

// ─── Audit ──────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // CREATE, UPDATE, DELETE
  entity    String   // Purchase, Sale, Product, etc.
  entityId  String
  details   Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}